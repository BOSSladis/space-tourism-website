---
interface Props {
  href: string;
  active: boolean;
  transitionName: string;
  class?: string;
}

const { href, active, transitionName, class: className } = Astro.props;
---

<a
  href={href}
  class:list={["nav-link", className]}
  aria-current={active ? "page" : undefined}
>
  <slot />
  {
    active && (
      <span class="nav-link__indicator" transition:name={transitionName} />
    )
  }
</a>

<style>
  .nav-link {
    position: relative;
    text-decoration: none;
    color: inherit;
    text-transform: uppercase;
    display: block;
  }

  .nav-link:not([aria-current="page"])::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 3px;
    /* background-color: hsl(from var(--white) h s l / 0.5); */
    background-color: var(--white);
    opacity: 0;
    /* transform: scaleX(0);
    transform-origin: var(--origin, right); */
    transition:
      transform 0.3s cubic-bezier(0.25, 1, 0.5, 1),
      opacity 0.3s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .nav-link:not([aria-current="page"]):hover::after {
    opacity: 0.5;
  }

  .nav-link:not([data-hover-axis="y"]):not([aria-current="page"])::after {
    transform: scaleX(0);
    transform-origin: var(--origin-x, left) bottom;
  }

  .nav-link:not([data-hover-axis="y"]):not([aria-current="page"]):hover::after {
    transform: scaleX(1);
  }

  .nav-link[data-hover-axis="y"]:not([aria-current="page"])::after {
    transform: scaleY(0);
    transform-origin: left var(--origin-y, top);
  }

  .nav-link[data-hover-axis="y"]:not([aria-current="page"]):hover::after {
    transform: scaleY(1);
  }

  .nav-link__indicator {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    height: 3px;
    background-color: var(--white);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link:not([aria-current="page"])::after {
      transition: none !important;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    // preventSamePageNavigation(".nav-link");

    function setHoverOrigin(event: MouseEvent) {
      //   const link = event.currentTarget as HTMLElement;
      //   const rect = link.getBoundingClientRect();
      //   const isLeft = event.clientX - rect.left < rect.width / 2;

      //   link.style.setProperty("--origin", isLeft ? "left" : "right");
      const link = event.currentTarget as HTMLElement;
      const rect = link.getBoundingClientRect();

      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;

      // distance à chaque bord
      const distances = {
        top: y,
        bottom: rect.height - y,
        left: x,
        right: rect.width - x,
      };

      // le bord le plus proche du point d'entrée/sortie
      const closestSide = Object.keys(distances).reduce((a, b) =>
        distances[a as keyof typeof distances] <
        distances[b as keyof typeof distances]
          ? a
          : b,
      );

      const isVertical = closestSide === "top" || closestSide === "bottom";

      link.dataset.hoverAxis = isVertical ? "y" : "x";
      link.style.setProperty(
        "--origin-x",
        closestSide === "left" ? "left" : "right",
      );
      link.style.setProperty(
        "--origin-y",
        closestSide === "top" ? "top" : "bottom",
      );
    }

    document.querySelectorAll<HTMLElement>(".nav-link").forEach((link) => {
      link.addEventListener("mouseenter", setHoverOrigin);
      link.addEventListener("mouseleave", setHoverOrigin);
    });
  });
</script>
